{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Macro Bridge",
  "version": "0.1.0",
  "identifier": "com.local.premieremacrobridge.configurator",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Macro Bridge",
        "width": 1040,
        "height": 760,
        "minWidth": 860,
        "minHeight": 560,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true,
        "backgroundColor": "#0d0e10"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
